<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        MSFS Mod Manager — Brand Identity System

        Brand concept: "Precision Flight Ops"
        - Aviation instrument aesthetic (circles, rings, precision lines)
        - Dark cockpit feel with accent blue (like PFD/ND screens)
        - Clean, professional, trustworthy
    -->

    <!-- ═══════════════ BRAND COLORS ═══════════════ -->

    <!-- Primary: Cockpit Blue — like PFD instrument displays -->
    <Color x:Key="BrandPrimaryColor">#FF58A6FF</Color>
    <Color x:Key="BrandPrimaryLightColor">#FF79C0FF</Color>
    <Color x:Key="BrandPrimaryDarkColor">#FF2D7DD2</Color>

    <!-- Secondary: Horizon Orange — like attitude indicator markings -->
    <Color x:Key="BrandSecondaryColor">#FFFF7B4A</Color>

    <!-- Neutrals: Cockpit Dark -->
    <Color x:Key="BrandDark1">#FF0D1117</Color>
    <Color x:Key="BrandDark2">#FF161B22</Color>
    <Color x:Key="BrandDark3">#FF21262D</Color>
    <Color x:Key="BrandDark4">#FF30363D</Color>

    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{DynamicResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandPrimaryLightBrush" Color="{DynamicResource BrandPrimaryLightColor}" />
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{DynamicResource BrandSecondaryColor}" />

    <!-- ═══════════════ GRADIENTS ═══════════════ -->

    <!-- Hero gradient for headers / splash -->
    <LinearGradientBrush x:Key="BrandHeroGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0D1117" Offset="0" />
        <GradientStop Color="#FF111D2E" Offset="0.4" />
        <GradientStop Color="#FF0F2744" Offset="0.7" />
        <GradientStop Color="#FF163561" Offset="1" />
    </LinearGradientBrush>

    <!-- Subtle blue glow for cards / panels -->
    <RadialGradientBrush x:Key="BrandGlowBrush" Center="0.5,0.3" RadiusX="0.8" RadiusY="0.8">
        <GradientStop Color="#1558A6FF" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>

    <!-- Background canvas gradient — deep space feel -->
    <LinearGradientBrush x:Key="BrandBackgroundGradient" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#FF080C12" Offset="0" />
        <GradientStop Color="#FF0D1117" Offset="0.3" />
        <GradientStop Color="#FF0F1923" Offset="0.6" />
        <GradientStop Color="#FF0D1117" Offset="1" />
    </LinearGradientBrush>

    <!-- Accent stripe for active items -->
    <LinearGradientBrush x:Key="BrandAccentStripe" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF58A6FF" Offset="0" />
        <GradientStop Color="#FF2D7DD2" Offset="1" />
    </LinearGradientBrush>

    <!-- ═══════════════ TYPOGRAPHY ═══════════════ -->

    <FontFamily x:Key="BrandFontPrimary">Segoe UI</FontFamily>
    <FontFamily x:Key="BrandFontMono">Cascadia Code, Consolas</FontFamily>

    <!-- ═══════════════ BACKGROUND CANVAS ELEMENTS ═══════════════ -->

    <!-- Decorative grid pattern (like avionics graph paper) -->
    <DrawingBrush x:Key="BrandGridPattern" TileMode="Tile"
                  Viewport="0,0,40,40" ViewportUnits="Absolute"
                  Opacity="0.04">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF58A6FF" Thickness="0.5" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="40,0" />
                            <LineGeometry StartPoint="0,0" EndPoint="0,40" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Compass rose / heading indicator decorative element -->
    <DrawingImage x:Key="BrandCompassRose">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!-- Outer ring -->
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="100,100" RadiusX="90" RadiusY="90" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2058A6FF" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Inner ring -->
                <GeometryDrawing>
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="100,100" RadiusX="70" RadiusY="70" />
                    </GeometryDrawing.Geometry>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#1558A6FF" Thickness="0.5" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <!-- Cross hairs -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#1058A6FF" Thickness="0.5" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="100,10" EndPoint="100,190" />
                            <LineGeometry StartPoint="10,100" EndPoint="190,100" />
                            <!-- Diagonals -->
                            <LineGeometry StartPoint="36,36" EndPoint="164,164" />
                            <LineGeometry StartPoint="164,36" EndPoint="36,164" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Cardinal tick marks -->
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#3058A6FF" Thickness="2" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="100,10" EndPoint="100,25" />
                            <LineGeometry StartPoint="100,175" EndPoint="100,190" />
                            <LineGeometry StartPoint="10,100" EndPoint="25,100" />
                            <LineGeometry StartPoint="175,100" EndPoint="190,100" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Center dot -->
                <GeometryDrawing Brush="#2058A6FF">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="100,100" RadiusX="3" RadiusY="3" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Altitude indicator lines — decorative side element -->
    <DrawingBrush x:Key="BrandAltitudeLines" TileMode="Tile"
                  Viewport="0,0,60,20" ViewportUnits="Absolute"
                  Opacity="0.06">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#FF58A6FF" Thickness="0.5" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,10" EndPoint="40,10" />
                            <LineGeometry StartPoint="20,0" EndPoint="60,0" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
