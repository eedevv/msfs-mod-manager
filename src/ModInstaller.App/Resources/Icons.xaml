    <!-- Toggle / Power -->
    <Geometry x:Key="IconToggle">M12,2 L12,12 M6.3,6.3 A8,8 0 1,0 17.7,6.3</Geometry>

    <!-- Download / Cloud download -->
    <Geometry x:Key="IconDownload">M12,3 L12,15 M7,11 L12,16 L17,11 M4,19 L20,19</Geometry>

    <!-- Export / Share -->
    <Geometry x:Key="IconExport">M12,3 L12,15 M7,7 L12,2 L17,7 M4,19 L20,19</Geometry>

    <!-- Info / About -->
    <Geometry x:Key="IconAbout">M12,2 A10,10 0 1,1 12,22 A10,10 0 1,1 12,2 Z M12,7 L12,8 M12,11 L12,17</Geometry>

    <!-- Globe / Browse -->
    <Geometry x:Key="IconBrowse">M12,2 A10,10 0 1,1 12,22 A10,10 0 1,1 12,2 Z M2,12 L22,12 M12,2 Q8,8 8,12 Q8,16 12,22 M12,2 Q16,8 16,12 Q16,16 12,22</Geometry>

</ResourceDictionary>
