    <!-- Install / Plus circle -->
    <Geometry x:Key="IconInstall">M12,2 A10,10 0 1,1 12,22 A10,10 0 1,1 12,2 Z M8,12 L16,12 M12,8 L12,16</Geometry>

    <!-- Refresh / Circular arrows -->
    <Geometry x:Key="IconRefresh">M12,4 A8,8 0 1,1 4,12 M12,4 L16,4 L12,0</Geometry>

    <!-- Folder open -->
    <Geometry x:Key="IconFolder">M2,6 L2,18 L22,18 L22,8 L12,8 L10,6 Z</Geometry>

