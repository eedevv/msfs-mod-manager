<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Vector icon paths using Segoe MDL2 Assets / Segoe Fluent Icons font.
        These render perfectly on all Windows systems unlike emoji.
    -->

    <!-- Nav icon data paths (simple geometric shapes) -->

    <!-- Mods / Package icon: box shape -->
    <Geometry x:Key="IconMods">M3,3 L21,3 L21,21 L3,21 Z M3,8 L21,8 M8,3 L8,8 M12,11 L12,18 M9,14 L12,11 L15,14</Geometry>

    <!-- Backup / Save icon: floppy disk -->
    <Geometry x:Key="IconBackup">M5,3 L17,3 L21,7 L21,21 L3,21 L3,3 Z M7,3 L7,8 L15,8 L15,3 M7,12 L17,12 L17,19 L7,19 Z</Geometry>

    <!-- Profile / User icon -->
    <Geometry x:Key="IconProfile">M12,12 A4,4 0 1,1 12,4 A4,4 0 1,1 12,12 Z M4,20 Q4,15 12,15 Q20,15 20,20</Geometry>

    <!-- Conflicts / Warning triangle -->
    <Geometry x:Key="IconConflict">M12,2 L22,20 L2,20 Z M12,9 L12,14 M12,16 L12,17</Geometry>

    <!-- Health / Heart with pulse -->
    <Geometry x:Key="IconHealth">M12,21 L3,13 A5,5 0 0,1 12,5 A5,5 0 0,1 21,13 Z</Geometry>

    <!-- Analytics / Bar chart -->
