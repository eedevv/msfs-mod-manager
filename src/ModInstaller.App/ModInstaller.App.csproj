<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ModInstaller.App</RootNamespace>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <AssemblyName>MSFSModManager</AssemblyName>
    <Version>3.0.0</Version>
    <Product>MSFS Mod Manager</Product>
    <Company>eedev</Company>
    <Description>The ultimate mod manager for Microsoft Flight Simulator 2020 and 2024</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModInstaller.Core\ModInstaller.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>


</Project>
