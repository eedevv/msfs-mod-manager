<UserControl x:Class="ModInstaller.App.Views.AnalyticsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <TextBlock Text="Storage Analytics" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Disk usage breakdown and mod statistics" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,24" />

            <!-- Summary cards row -->
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">
                <Border Background="#10FFFFFF" CornerRadius="10" Padding="16,14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock x:Name="TotalMods" Text="0" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Total Mods" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="#10FFFFFF" CornerRadius="10" Padding="16,14" Margin="4,0">
                    <StackPanel>
                        <TextBlock x:Name="TotalSize" Text="0 GB" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="Total Size" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="#10FFFFFF" CornerRadius="10" Padding="16,14" Margin="4,0">
                    <StackPanel>
                        <TextBlock x:Name="JunctionCount" Text="0" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="Junctions" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="#10FFFFFF" CornerRadius="10" Padding="16,14" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock x:Name="DisabledCount" Text="0" FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" />
                        <TextBlock Text="Disabled" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Usage by type -->
            <TextBlock Text="USAGE BY TYPE" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />

            <Border Background="#10FFFFFF" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                <ItemsControl x:Name="TypeBreakdown">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Type}" FontSize="12" VerticalAlignment="Center" />

                                <Border Grid.Column="1" Height="8" CornerRadius="4"
                                        Background="#15FFFFFF" Margin="8,0" VerticalAlignment="Center">
                                    <Border CornerRadius="4" HorizontalAlignment="Left"
                                            Width="{Binding BarWidth}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FF2D7DD2" Offset="0" />
                                                <GradientStop Color="#FF58A6FF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Border>

                                <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="Cascadia Code, Consolas" VerticalAlignment="Center"
                                           TextAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding Count, StringFormat='{}{0} mods'}" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                           TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Top 10 largest mods -->
            <TextBlock Text="LARGEST MODS" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />

            <Border Background="#10FFFFFF" CornerRadius="12" Padding="16">
                <ItemsControl x:Name="LargestMods">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Rank}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontFamily="Cascadia Code, Consolas" VerticalAlignment="Center"
                                           TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
