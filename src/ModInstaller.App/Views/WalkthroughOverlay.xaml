<UserControl x:Class="ModInstaller.App.Views.WalkthroughOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="OverlayRoot"
             Foreground="{DynamicResource TextPrimaryBrush}"
             Visibility="Collapsed">

    <!-- Full-screen dark overlay -->
    <Grid Background="#E5080C12">
        <!-- Center card -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="560" MaxHeight="480"
                CornerRadius="16" Padding="0"
                BorderBrush="{DynamicResource GlassPanelBorderBrush}" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF131820" Offset="0" />
                    <GradientStop Color="#FF0F1318" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#FF58A6FF" BlurRadius="40" ShadowDepth="0" Opacity="0.15" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Content area -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="36,32,36,20">
                    <StackPanel>
                        <!-- Step content changes dynamically -->

                        <!-- Step indicator dots -->
                        <StackPanel x:Name="StepDots" Orientation="Horizontal" HorizontalAlignment="Center"
                                    Margin="0,0,0,24">
                            <!-- Filled dynamically -->
                        </StackPanel>

                        <!-- Icon -->
                        <Border x:Name="StepIcon" Width="64" Height="64" Margin="0,0,0,20" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF58A6FF" BlurRadius="20" ShadowDepth="0" Opacity="0.3" />
                            </Border.Effect>
                            <Image Source="{DynamicResource AppIconDrawing}" />
                        </Border>

                        <!-- Title -->
                        <TextBlock x:Name="StepTitle" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,0,0,10" />

                        <!-- Description -->
                        <TextBlock x:Name="StepDescription" FontSize="14" LineHeight="22"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />

                        <!-- Tip box (optional per step) -->
                        <Border x:Name="StepTipBox" CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
                                Background="#0858A6FF" BorderBrush="#1558A6FF" BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="StepTip" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer with buttons -->
                <Border Grid.Row="1" Padding="36,16,36,24"
                        BorderBrush="#08FFFFFF" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SkipButton" Grid.Column="0" Content="Skip Tutorial"
                                Style="{DynamicResource AnimatedSecondaryButton}"
                                Click="Skip_Click" Padding="16,8" FontSize="12" />

                        <!-- Step counter -->
                        <TextBlock x:Name="StepCounter" Grid.Column="1" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" />

                        <Button x:Name="NextButton" Grid.Column="2"
                                Style="{DynamicResource AnimatedPrimaryButton}"
                                Click="Next_Click" Padding="20,8" FontSize="13">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="NextButtonText" Text="Next" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
