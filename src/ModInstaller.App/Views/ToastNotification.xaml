<UserControl x:Class="ModInstaller.App.Views.ToastNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ToastRoot"
             HorizontalAlignment="Right" VerticalAlignment="Top"
             Margin="0,16,16,0" Width="360"
             Opacity="0" IsHitTestVisible="True"
             RenderTransformOrigin="1,0">
    <UserControl.RenderTransform>
        <TransformGroup>
            <TranslateTransform X="380" />
        </TransformGroup>
    </UserControl.RenderTransform>

    <Border x:Name="ToastBorder" CornerRadius="12" Padding="16,14"
            BorderThickness="1" BorderBrush="#FF30363D">
        <Border.Background>
            <SolidColorBrush Color="#FF1C2128" />
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <Border x:Name="IconBorder" Grid.Column="0" Width="32" Height="32"
                    CornerRadius="16" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="IconText" Text="&#x2714;" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White" />
            </Border>

            <!-- Message -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Success" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="MessageText" Text="" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Close button -->
            <Button Grid.Column="2" Content="&#x2715;" FontSize="12"
                    Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"
                    BorderThickness="0" Cursor="Hand" Width="24" Height="24"
                    VerticalAlignment="Top" Click="CloseButton_Click" />
        </Grid>
    </Border>
</UserControl>
