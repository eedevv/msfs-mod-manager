<UserControl x:Class="ModInstaller.App.Views.BackupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Backup Manager" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="Create, restore, and manage mod backups" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Action bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="&#x1F4BE;  Backup All Mods" Style="{DynamicResource AnimatedPrimaryButton}"
                    Click="BackupAll_Click" Margin="0,0,8,0" />
            <Button Content="&#x1F4C2;  Open Backup Folder" Style="{DynamicResource AnimatedSecondaryButton}"
                    Click="OpenBackupFolder_Click" Margin="0,0,8,0" />
            <Button Content="&#x1F5D1;  Clean Old Backups" Style="{DynamicResource AnimatedSecondaryButton}"
                    Click="CleanBackups_Click" />
        </StackPanel>

        <!-- Backup list -->
        <Border Grid.Row="2" Background="#10FFFFFF" CornerRadius="12" Padding="0">
            <ListView x:Name="BackupList" Background="Transparent" BorderThickness="0"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16,12" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding CreatedDate, StringFormat='{}{0:MMM dd, yyyy  HH:mm}'}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,16,0" />
                                        <TextBlock Text="{Binding SizeDisplay}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" Content="Restore" Style="{DynamicResource AnimatedSecondaryButton}"
                                        Tag="{Binding Path}" Click="RestoreBackup_Click"
                                        Padding="12,6" FontSize="11" Margin="0,0,8,0" />
                                <Button Grid.Column="2" Content="&#x2715;" Style="{DynamicResource AnimatedSecondaryButton}"
                                        Tag="{Binding Path}" Click="DeleteBackup_Click"
                                        Padding="8,6" FontSize="11" Foreground="{DynamicResource ErrorBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>

                <!-- Empty state -->
                <ListView.Style>
                    <Style TargetType="ListView">
                        <Style.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0">
                                                <TextBlock Text="No backups yet" FontSize="16" FontWeight="Light"
                                                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="Create a backup to protect your mods" FontSize="12"
                                                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                                                           Margin="0,4,0,0" Opacity="0.5" />
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>
            </ListView>
        </Border>
    </Grid>
</UserControl>
